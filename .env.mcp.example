# The MCP token contract: the keys that live in .env.mcp and nowhere else.
#
# Optional, and only for working on this repo with Claude Code. Building and
# testing the module needs none of it.
#
# Only `task mcp:headers` loads .env.mcp: it is the headers helper Claude Code
# runs when it connects to an MCP server. No other task sees a token.
#
# Two ways to fill it:
#   - By hand: copy this file to .env.mcp and fill in the values.
#   - 1Password: copy this file to .env.1password (gitignored) and give each
#     key an op://<vault>/<item>/<field> reference. `task setup:secrets`
#     resolves them into .env.mcp on every run, so re-running it picks up a
#     rotated token.
#
# Values unquoted. Then register the servers: task setup:mcp

# GitHub PAT for the github MCP.
GITHUB_PAT=
# Context7 API key for the context7 MCP.
CONTEXT7_API_KEY=
